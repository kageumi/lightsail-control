{
  "name": "lightsail-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "test:dev": "node scripts/check-dev.mjs",
    "verify": "npm run check && npm run lint && npm test && npm run build",
    "preview": "npm run build && wrangler dev --config tests/wrangler.preview.jsonc --port 8788 --inspector-port 9230"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "brace-expansion@^5.0.0": "^5.0.12",
    "source-map-js": "^1.2.2",
    "undici@^7.0.0": "^7.29.1"
  }
}
